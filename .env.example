# API Configuration
PORT=8000

# Default AI provider
DEFAULT_AI_PROVIDER=openai  # Options: openai, anthropic, mistral, google, ollama, deepseek, azure

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: For OpenAI compatible APIs

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_ID=claude-3-opus-20240229

# MistralAI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_ID=mistral-large-latest

# Google AI Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_ID=gemini-1.5-pro

# Ollama Configuration
OLLAMA_API_BASE=http://localhost:11434  # For local Ollama instance
OLLAMA_MODEL_ID=gemma4:e4b-it-q4_K_M # lfm2.5:8b or gemma4:e4b-it-q4_K_M

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL_ID=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Azure OpenAI Configuration
AZURE_API_KEY=your_azure_api_key_here
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_DEPLOYMENT_NAME=your_deployment_name
AZURE_API_VERSION=2023-05-15

# Browser Configuration
BROWSER_USE_HEADFUL=true  # Set to true to show browser UI, false to run in headless mode
BROWSER_USE_VISION=false  # Set true only if your selected model supports multimodal (image) input
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome  # macOS path
# Windows path: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux path: /usr/bin/google-chrome
CHROME_USER_DATA=~/Library/Application Support/Google/Chrome  # macOS path
# Windows path: C:\Users\<username>\AppData\Local\Google\Chrome\User Data
# Linux path: ~/.config/google-chrome

# Optional Configuration
# LOG_LEVEL=INFO 

# Performance Guardrails
TASK_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=8
STATUS_TRACK_STEPS_ON_POLL=false
STATUS_CAPTURE_SCREENSHOT=false
STATUS_SCREENSHOT_MIN_INTERVAL_SECONDS=10
AGENT_ENFORCE_CONCISE_EXECUTION=true
ENABLE_SIMPLE_TITLE_SHORTCUT=true
PASS_SENSITIVE_DATA_TO_AGENT=false
LOOP_GUARD_MAX_CONSECUTIVE_DUPLICATE_SCREENSHOTS=3
LOOP_GUARD_MAX_SCREENSHOT_ERRORS=3